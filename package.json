{
  "name": "@civ-clone/base-city-lifecycle",
  "version": "0.1.1",
  "description": "A city's turn: its food stored and its production built, growing or running out of food, the squares it can work, its units unsupported, and the city actions offered to its player.",
  "repository": "git@github.com:civ-clone/base-city-lifecycle.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/library-city": "0.1.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^14.18.63",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.1.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@civ-clone/base-terrain-yield-food": "^0.1.0",
    "@civ-clone/base-terrain-yield-production": "^0.1.0",
    "@civ-clone/base-terrain-yield-trade": "^0.1.0",
    "@civ-clone/core-city": "^0.1.24",
    "@civ-clone/core-city-build": "^0.1.22",
    "@civ-clone/core-city-growth": "^0.1.6",
    "@civ-clone/core-city-happiness": "^0.1.2",
    "@civ-clone/core-engine": "^0.1.4",
    "@civ-clone/core-player": "^0.1.8",
    "@civ-clone/core-player-world": "^0.1.14",
    "@civ-clone/core-rule": "^0.1.5",
    "@civ-clone/core-unit": "^0.1.31",
    "@civ-clone/core-world": "^0.1.19",
    "@civ-clone/core-yield": "^0.1.5"
